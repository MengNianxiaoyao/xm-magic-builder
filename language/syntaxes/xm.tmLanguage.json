{
    "name": "XM Language",
    "patterns": [
        {
            "include": "#magic-manage"
        },
        {
            "include": "#variable-decl"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#variables"
        }
    ],
    "repository": {
        "magic-manage": {
            "patterns": [
                {
                    "name": "meta.magic-manage.xm",
                    "begin": "^ *魔法管理",
                    "end": "\\}",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.magic-manage-header.xm"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "keyword.magic-manage-footer.xm"
                        }
                    },
                    "contentName": "meta.magic-manage-params.xm",
                    "patterns": [
                        {
                            "name": "entity.name.type.xm",
                            "match": "[^{=|}]+(?==)"
                        },
                        {
                            "name": "string.magic-manage-value.xm",
                            "match": "(?<==)[^{=|}]+"
                        },
                        {
                            "name": "punctuation.separator.xm",
                            "match": "[|=]"
                        }
                    ]
                }
            ]
        },
        "condition-params": {
            "name": "meta.condition-params.xm",
            "begin": "\\{",
            "end": "\\}",
            "patterns": [
                {
                    "name": "keyword.compare-op.xm",
                    "match": "[大小](?:于(?:等于)?)?|(?:十六|二)进制|等于|不等于"
                },
                {
                    "name": "constant.numeric.xm",
                    "match": "\\d+"
                },
                {
                    "include": "#variable-ref"
                }
            ]
        },
        "variable-ref": {
            "begin": "\\[",
            "end": "\\]",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.bracket.xm"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.bracket.xm"
                }
            },
            "contentName": "variable.other.xm",
            "patterns": [
                {
                    "name": "string.regexp.xm",
                    "match": "'[^']*'"
                },
                {
                    "name": "comment.line.xm",
                    "match": "[*+\\-/%]"
                },
                {
                    "name": "constant.numeric.xm",
                    "match": "\\d+"
                }
            ]
        },
        "numeric-expression": {
            "name": "constant.numeric.expression.xm",
            "begin": "#<",
            "end": ">#",
            "patterns": [
                {
                    "name": "comment.line.xm",
                    "match": "[*+\\-/%]"
                },
                {
                    "name": "constant.numeric.xm",
                    "match": "\\d+"
                },
                {
                    "include": "#variable-ref"
                },
                {
                    "include": "#condition-params"
                }
            ]
        },
        "variable-decl": {
            "patterns": [
                {
                    "name": "meta.variable-decl.xm",
                    "begin": "^ *变量",
                    "end": "$",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.variable-header.xm"
                        }
                    },
                    "patterns": [
                        {
                            "name": "entity.name.function.xm",
                            "match": "整数型|文本型"
                        },
                        {
                            "name": "invalid.xm",
                            "match": "清空变量"
                        },
                        {
                            "name": "keyword.compare-op.xm",
                            "match": "[大小](?:于(?:等于)?)?|(?:十六|二)进制|等于|不等于"
                        },
                        {
                            "name": "constant.numeric.xm",
                            "match": "\\d+"
                        },
                        {
                            "name": "constant.name.xm",
                            "match": "\\|([^|]+)\\|([^|]+)",
                            "captures": {
                                "1": {
                                    "name": "variable.name.xm"
                                },
                                "2": {
                                    "name": "string.name.xm"
                                }
                            }
                        },
                        {
                            "include": "#numeric-expression"
                        },
                        {
                            "include": "#variable-ref"
                        },
                        {
                            "name": "variable.other.xm",
                            "match": "([0-9a-zA-Z]+)"
                        },
                        {
                            "name": "punctuation.separator.xm",
                            "match": "[|=]"
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.xm",
                    "match": "^ *(?:发包|(?:对战)?延时|接管对战|精灵(?:首发|切换-ID|切换-位置)|设置背包|使用(?:技能|道具)|战前准备|信息输出|自定义(?:出招|魔法)|野怪操作-(对战|捕捉)|(?:出招|对战|判断|计次)循环体)"
                },
                {
                    "name": "keyword.xm",
                    "match": "(?:判断(?:真|假)\\d*)|跳出循环|(?:对战胜利|对战未触发)?(?:头|尾)部"
                },
                {
                    "name": "variable.name.xm",
                    "match": "(?<=计次循环体=(?:头|尾)部\\|)[^|]+"
                },
                {
                    "name": "support.function.xm",
                    "match": "(?:且|或|forstart|forend|whilestart|whileend|break|if|else|and|or|还原背包|撤退|全精灵恢复|压血|领取[^火]+火)"
                },
                {
                    "name": "keyword.strings.xm",
                    "match": "明文"
                },
                {
                    "name": "comment.line.xm",
                    "match": "[^\\s|=]+\\.(?:xmcus|xmgic|xmagic)\\b"
                },
                {
                    "name": "constant.numeric.xm",
                    "match": "\\b\\d+\\b"
                },
                {
                    "name": "constant.numeric.hex.xm",
                    "match": "(?<!\\[)\\b[0-9A-Fa-f]{8,}\\b(?!\\])"
                },
                {
                    "name": "keyword.strings.xm",
                    "match": "[0-9a-zA-Z]+"
                },
                {
                    "include": "#numeric-expression"
                },
                {
                    "include": "#condition-params"
                },
                {
                    "name": "constant.character.escape.xm",
                    "match": "\\\\(r|n)|\\\\r\\\\n"
                },
                {
                    "name": "punctuation.separator.xm",
                    "match": "[|=：/]"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.xm",
                    "match": "\\[([^\\]]+)\\]"
                }
            ]
        }
    },
    "scopeName": "source.xm"
}