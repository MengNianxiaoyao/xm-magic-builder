// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch",
            "dependsOn": ["pnpm: watch:tsc", "pnpm: watch:esbuild", "pnpm: watch:webview"],
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "command": "pnpm run watch:esbuild",
            "group": "build",
            "problemMatcher": {
                "owner": "esbuild",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "\\[esbuild\\] build started",
                    "endsPattern": "\\[esbuild\\] build finished"
                }
            },
            "isBackground": true,
            "label": "pnpm: watch:esbuild",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
        {
            "type": "shell",
            "command": "pnpm run watch:webview",
            "group": "build",
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "building for production",
                    "endsPattern": "built in \\d+ms"
                }
            },
            "isBackground": true,
            "label": "pnpm: watch:webview",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
        {
            "type": "shell",
            "command": "pnpm run watch:tsc",
            "group": "build",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "label": "pnpm: watch:tsc",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
        {
            "type": "shell",
            "command": "pnpm run watch-tests",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            },
            "group": "build",
            "label": "pnpm: watch-tests"
        },
        {
            "label": "tasks: watch-tests",
            "dependsOn": ["watch", "pnpm: watch-tests"],
            "problemMatcher": []
        }
    ]
}
