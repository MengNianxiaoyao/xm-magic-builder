{
    "publisher": "MengNianxiaoyao",
    "name": "xm-magic-builder",
    "displayName": "XMSeer's Magic Builder",
    "description": "An XMSeer's magic build tool",
    "author": "MengNianxiaoyao",
    "homepage": "https://github.com/MengNianxiaoyao/xm-magic-builder#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/MengNianxiaoyao/xm-magic-builder"
    },
    "bugs": {
        "url": "https://github.com/MengNianxiaoyao/xm-magic-builder/issues"
    },
    "version": "1.2.3",
    "release": {
        "preRelease": false
    },
    "engines": {
        "vscode": "^1.118.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "icon": "resources/icon.png",
    "main": "./dist/extension.js",
    "vsce": {
        "dependencies": false
    },
    "contributes": {
        "commands": [
            {
                "command": "xm-magic-builder.refresh.send-packet",
                "title": "重置发包延时",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.pokemon-operation",
                "title": "重置精灵操作",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.pokemon-training",
                "title": "重置精灵培养",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.battle-operation",
                "title": "重置对战操作",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.attack-loop",
                "title": "重置出招循环体",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.battle-loop",
                "title": "重置对战循环体",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.custom-attack",
                "title": "重置自定义出招",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.wild-pokemon",
                "title": "重置野怪操作",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.variable",
                "title": "重置变量",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.if-loop",
                "title": "重置判断循环体",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.count-loop",
                "title": "重置计次循环体",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.output",
                "title": "重置信息输出",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.custom-magic",
                "title": "重置自定义魔法",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.magic-manage",
                "title": "刷新魔法管理",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.game-data",
                "title": "重置数据查询",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.refresh.completion-stats",
                "title": "刷新补全统计",
                "icon": "$(refresh)"
            },
            {
                "command": "xm-magic-builder.update-game-data",
                "title": "更新游戏数据",
                "icon": "$(cloud-download)"
            }
        ],
        "configuration": {
            "title": "XMSeer's Builder",
            "properties": {
                "xm-magic-builder.gameData.autoUpdate": {
                    "type": "boolean",
                    "default": true,
                    "description": "每天自动检查并更新精灵、技能、刻印数据。关闭后锁定当前数据，仍可在“数据查询”面板手动更新。"
                }
            }
        },
        "languages": [
            {
                "id": "xm",
                "extensions": [
                    ".xm"
                ],
                "aliases": [
                    "XM Language"
                ],
                "configuration": "./language/language-configuration.json"
            }
        ],
        "configurationDefaults": {
            "[xm]": {
                "editor.wordWrap": "off",
                "editor.maxTokenizationLineLength": 200000
            }
        },
        "grammars": [
            {
                "language": "xm",
                "scopeName": "source.xm",
                "path": "./language/syntaxes/xm.tmLanguage.json"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "xm-magic-builder-sidebar",
                    "title": "XM魔法编辑器",
                    "icon": "resources/icon.png"
                }
            ]
        },
        "views": {
            "xm-magic-builder-sidebar": [
                {
                    "id": "xm-magic-builder.send-packet",
                    "name": "发包延时",
                    "type": "webview",
                    "icon": "$(arrow-up)"
                },
                {
                    "id": "xm-magic-builder.pokemon-operation",
                    "name": "精灵操作",
                    "type": "webview",
                    "icon": "$(symbol-variable)"
                },
                {
                    "id": "xm-magic-builder.pokemon-training",
                    "name": "精灵培养",
                    "type": "webview",
                    "icon": "$(heart)"
                },
                {
                    "id": "xm-magic-builder.battle-operation",
                    "name": "对战操作",
                    "type": "webview",
                    "icon": "$(zap)"
                },
                {
                    "id": "xm-magic-builder.attack-loop",
                    "name": "出招循环体",
                    "type": "webview",
                    "icon": "$(repeat)"
                },
                {
                    "id": "xm-magic-builder.battle-loop",
                    "name": "对战循环体",
                    "type": "webview",
                    "icon": "$(sync)"
                },
                {
                    "id": "xm-magic-builder.custom-attack",
                    "name": "自定义出招",
                    "type": "webview",
                    "icon": "$(edit)"
                },
                {
                    "id": "xm-magic-builder.wild-pokemon",
                    "name": "野怪操作",
                    "type": "webview",
                    "icon": "$(compass)"
                },
                {
                    "id": "xm-magic-builder.variable",
                    "name": "变量",
                    "type": "webview",
                    "icon": "$(symbol-variable)"
                },
                {
                    "id": "xm-magic-builder.if-loop",
                    "name": "判断循环体",
                    "type": "webview",
                    "icon": "$(git-branch)"
                },
                {
                    "id": "xm-magic-builder.count-loop",
                    "name": "计次循环体",
                    "type": "webview",
                    "icon": "$(list-ordered)"
                },
                {
                    "id": "xm-magic-builder.custom-magic",
                    "name": "自定义魔法",
                    "type": "webview",
                    "icon": "$(sparkle)"
                },
                {
                    "id": "xm-magic-builder.output",
                    "name": "信息输出",
                    "type": "webview",
                    "icon": "$(output)"
                },
                {
                    "id": "xm-magic-builder.magic-manage",
                    "name": "魔法管理",
                    "type": "webview",
                    "icon": "$(settings-gear)"
                },
                {
                    "id": "xm-magic-builder.game-data",
                    "name": "数据查询",
                    "type": "webview",
                    "icon": "$(search)"
                },
                {
                    "id": "xm-magic-builder.completion-stats",
                    "name": "补全使用统计",
                    "type": "webview",
                    "icon": "$(graph)"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "xm-magic-builder.refresh.send-packet",
                    "when": "view == xm-magic-builder.send-packet",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.pokemon-operation",
                    "when": "view == xm-magic-builder.pokemon-operation",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.pokemon-training",
                    "when": "view == xm-magic-builder.pokemon-training",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.battle-operation",
                    "when": "view == xm-magic-builder.battle-operation",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.attack-loop",
                    "when": "view == xm-magic-builder.attack-loop",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.battle-loop",
                    "when": "view == xm-magic-builder.battle-loop",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.custom-attack",
                    "when": "view == xm-magic-builder.custom-attack",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.wild-pokemon",
                    "when": "view == xm-magic-builder.wild-pokemon",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.variable",
                    "when": "view == xm-magic-builder.variable",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.if-loop",
                    "when": "view == xm-magic-builder.if-loop",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.count-loop",
                    "when": "view == xm-magic-builder.count-loop",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.output",
                    "when": "view == xm-magic-builder.output",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.custom-magic",
                    "when": "view == xm-magic-builder.custom-magic",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.magic-manage",
                    "when": "view == xm-magic-builder.magic-manage",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.game-data",
                    "when": "view == xm-magic-builder.game-data",
                    "group": "navigation"
                },
                {
                    "command": "xm-magic-builder.refresh.completion-stats",
                    "when": "view == xm-magic-builder.completion-stats",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "pnpm run check-types && pnpm run lint && pnpm run build:webview && node esbuild.js",
        "watch": "pnpm run \"/^watch:/\"",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "watch:webview": "vite build --watch",
        "package": "pnpm run check-types && pnpm run lint && pnpm run build:webview && node esbuild.js --production",
        "build:webview": "vite build",
        "build:seed": "node scripts/build-seed.mjs",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "check-types": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.webview.json",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint src --fix",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "^1.118.0",
        "@vitejs/plugin-vue": "6.0.1",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "esbuild": "^0.27.3",
        "eslint": "^9.39.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "prettier": "^3.8.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "7.1.11",
        "vue": "3.5.13",
        "vue-tsc": "3.1.1"
    },
    "dependencies": {
        "iconv-lite": "^0.7.3"
    }
}
